apiVersion: agentward/v1
kind: AgentPolicy
metadata:
  name: personal-assistant
  owner: solo
spec:
  subject: personal-assistant
  expiresAt: "2027-03-31"
  defaultEffect: Deny
  rules:
    - effect: Allow
      actions: [calendar.list]
      constraints: {}
    - effect: Allow
      actions: [calendar.read]
      constraints: {}
    - effect: Allow
      actions: [contacts.read]
      constraints: {}
    - effect: Allow
      actions: [gmail.read]
      constraints: {}
    - effect: Allow
      actions: [gmail.search]
      constraints: {}
    - effect: Allow
      actions: [http.get]
      constraints: {}
    - effect: Deny
      actions: [gmail.delete]
    - effect: Deny
      actions: [gmail.send]
    - effect: Deny
      actions: [payments.charge]
    - effect: Deny
      actions: [shell.exec]
