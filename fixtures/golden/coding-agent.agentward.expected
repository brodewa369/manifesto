# manifesto export -> agentward (APPROXIMATION)
# generated by manifesto 0.3.0 | dialects are approximations, not certified vendor schemas — review before enforcing
apiVersion: agentward/v1
kind: AgentPolicy
metadata:
  name: coding-agent
  owner: platform-team
spec:
  subject: coding-agent
  expiresAt: "2027-12-31"
  defaultEffect: Deny
  rules:
    - effect: Allow
      actions: [fs.read]
      constraints: {}
    - effect: Allow
      actions: [fs.write]
      constraints:
        toDomains: [example.internal]
    - effect: Allow
      actions: [github.read]
      constraints: {}
    - effect: Allow
      actions: [github.write]
      constraints: {}
    - effect: Allow
      actions: [http.get]
      constraints: {}
    - effect: Allow
      actions: [shell.exec]
      constraints:
        rateMax: 20
        rateWindow: PT1H
        requiresApproval: true
    - effect: Deny
      actions: [fs.delete]
    - effect: Deny
      actions: [gmail.send]
    - effect: Deny
      actions: [payments.charge]
