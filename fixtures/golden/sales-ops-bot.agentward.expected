# manifesto export -> agentward (APPROXIMATION)
# generated by manifesto 0.4.0 | dialects are approximations, not certified vendor schemas — review before enforcing
apiVersion: agentward/v1
kind: AgentPolicy
metadata:
  name: sales-ops-bot
  owner: revenue-team
spec:
  subject: sales-ops-bot
  expiresAt: "2027-06-30"
  defaultEffect: Deny
  rules:
    - effect: Allow
      actions: [calendar.create]
      constraints: {}
    - effect: Allow
      actions: [calendar.read]
      constraints: {}
    - effect: Allow
      actions: [gmail.draft]
      constraints: {}
    - effect: Allow
      actions: [gmail.read]
      constraints: {}
    - effect: Allow
      actions: [gmail.send]
      constraints: {}
    - effect: Allow
      actions: [payments.charge]
      constraints:
        amountMax: 500
        currency: USD
        window: P1D
        requiresApproval: false
    - effect: Deny
      actions: [fs.delete]
    - effect: Deny
      actions: [payments.payout]
    - effect: Deny
      actions: [shell.exec]
