# manifesto export -> agentward (APPROXIMATION)
# generated by manifesto 0.2.0 | dialects are approximations, not certified vendor schemas — review before enforcing
apiVersion: agentward/v1
kind: AgentPolicy
metadata:
  name: sales-lead
  owner: revenue-team
spec:
  subject: sales-lead
  expiresAt: "2027-06-30"
  defaultEffect: Deny
  rules:
    - effect: Allow
      actions: [gmail.send]
      constraints:
        rateMax: 100
        rateWindow: P1D
    - effect: Allow
      actions: [payments.charge]
      constraints:
        amountMax: 500
        currency: USD
        window: P1D
    - effect: Allow
      actions: [shell.exec]
      constraints:
        requiresApproval: true
    - effect: Deny
      actions: [payments.payout]
  delegations:
    - from: sales-lead
      to: sales-ops
      purpose: coverage handoff
      expiresAt: "2027-06-30"
      narrowedActions: [gmail.send, payments.charge]
