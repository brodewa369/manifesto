// manifesto export -> cedar (APPROXIMATION)
// generated by manifesto 0.4.0 | dialects are approximations, not certified vendor schemas — review before enforcing
//
// contract: coding-agent | version: 1 | owner: platform-team
// description: Autonomous refactoring agent with a shell-exec approval gate.
// ttl: 2027-12-31 (APPROXIMATION: expiry is a comment only — enforce contract expiry outside Cedar)
//
// mapping (manifesto -> Cedar; full table in SPEC.md, Interop):
//   agent                  -> principal == Agent::"<agent>"       [APPROXIMATION: no schema/entity store emitted]
//   grants.<system>.<verb> -> action == Action::"<key>"           [action ids preserved verbatim]
//   grant value `true`     -> bare permit(...) with no condition  [exact]
//   amount/rate/to_domains/approval -> when { context.* }         [APPROXIMATION: enforcer supplies the request context]
//   deny: <key>            -> forbid(...)                         [Cedar forbid always wins; manifesto's deny dominates too]
//   delegations            -> extra permit(...) for the sub-agent [APPROXIMATION: no principal-hierarchy/transfer emitted]
//   ttl                    -> comment only                        [APPROXIMATION: contract expiry enforced outside Cedar]
//   default deny           -> Cedar implicit deny                 [native Cedar behaviour, no statement emitted]
// Cedar policy overrides below are APPROXIMATIONS: byte-stable (golden-tested) and semantics reviewed manually — NOT vendor-certified.
//
// default: no matching permit -> request not applicable -> implicit deny

permit(
  principal == Agent::"coding-agent",
  action == Action::"fs.read",
  resource
);
permit(
  principal == Agent::"coding-agent",
  action == Action::"fs.write",
  resource
)
when {
  context.to_domain == "example.internal"
};
permit(
  principal == Agent::"coding-agent",
  action == Action::"github.read",
  resource
);
permit(
  principal == Agent::"coding-agent",
  action == Action::"github.write",
  resource
);
permit(
  principal == Agent::"coding-agent",
  action == Action::"http.get",
  resource
);
permit(
  principal == Agent::"coding-agent",
  action == Action::"shell.exec",
  resource
)
when {
  context.rate_max == 20
  && context.rate_window == "PT1H"
  && context.approval == "required"
};
forbid(
  principal == Agent::"coding-agent",
  action == Action::"fs.delete",
  resource
);
forbid(
  principal == Agent::"coding-agent",
  action == Action::"gmail.send",
  resource
);
forbid(
  principal == Agent::"coding-agent",
  action == Action::"payments.charge",
  resource
);
